# Copy to .env only if you want to change something. The app starts without any .env (D-009).
# Every value here is optional and empty by default.

# API port (default 3001). The web dev server proxies /api to it.
# Only this repo-root .env file is supported. Vite would also read .env.local and
# .env.development[.local], but the server does not, so don't put settings there.
PORT=

# SQLite file (default app/server/data/sonrisa.db).
DATABASE_PATH=

# Email over SMTP (D-010). Leave empty to use the dev outbox in the admin view.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Connect Slack button (D-007, D-021). Leave empty: the button is shown disabled and
# users paste a hooks.slack.com webhook instead. Slack requires an HTTPS redirect URI (Q5).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
